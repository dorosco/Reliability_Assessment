   8  *===============================================================================
   9  * PARTE 1: DECLARACIÓN DE CONJUNTOS BASE
  10  *===============================================================================
  11  OPTION DECIMALS = 8;
  12  SETS
  13      n            /n1*n100/
  14      DATA_n       /Node, NC, L_MW/
  15      l            /l1*l100/
  16      DATA_l       /u, v, km, lambda, Tao_RP, Tao_SW/
  17      i            /1*100/
  18  ;
  19   
  20  ALIAS (i, j, s, r, ii, jj);
  21   
  22  *===============================================================================
  23  * PARTE 2: PARÁMETROS DE ENTRADA
  24  *===============================================================================
  25   
  26  PARAMETERS
  27      DATA_NODOS(n,DATA_n)
  28      DATA_LINEAS(l,DATA_l)
  29  ;
  30   
